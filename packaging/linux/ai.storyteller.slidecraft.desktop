[Desktop Entry]
Type=Application
Name=SlideCraft
GenericName=Presentation
Comment=Create and present slide decks
Exec=slidecraft %F
TryExec=slidecraft
Icon=ai.storyteller.slidecraft
Terminal=false
StartupNotify=true
StartupWMClass=ai.storyteller.slidecraft
Categories=Office;Presentation;
MimeType=application/x-slidecraft;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.openxmlformats-officedocument.presentationml.slideshow;
Keywords=presentation;slides;slide show;deck;pptx;keynote;powerpoint;
